package yggdrasil: json5;

world host {
    export ast;
}

interface ast {
    use peg: core/types.{parse-error};
    use peg: core/cst.{syntax-node};

    /// Token type of the language
    enum json5-token {
        %value,
        %object,
        %object-pair,
        %object-key,
        %array,
        %string,
        %double-string-element,
        %single-string-element,
        %hex-escape,
        %any-escape,
        %double-string-text,
        %single-string-text,
        %number,
        %boolean,
        %null,
        %identifier,
        %colon,
        %comma,
        %comment,
        %white-space,
        %string0,
        %string1,
        %boolean0,
        %boolean1,
        %hidden-text,
    }

    variant json5-type {
        %value(json5-value-node),
        %object(json5-object-node),
        %object-pair(json5-object-pair-node),
        %object-key(json5-object-key-node),
        %array(json5-array-node),
        %string(json5-string-node),
        %double-string-element(json5-double-string-element-node),
        %single-string-element(json5-single-string-element-node),
        %hex-escape(json5-hex-escape-node),
        %any-escape(json5-any-escape-node),
        %double-string-text(json5-double-string-text-node),
        %single-string-text(json5-single-string-text-node),
        %number(json5-number-node),
        %boolean(json5-boolean-node),
        %null(json5-null-node),
        %identifier(json5-identifier-node),
        %colon(json5-colon-node),
        %comma(json5-comma-node),
        %comment(json5-comment-node),
        %white-space(json5-white-space-node),
        %string0(json5-string0-node),
        %string1(json5-string1-node),
        %boolean0(json5-boolean0-node),
        %boolean1(json5-boolean1-node),
    }
    // AST Types
    variant json5-value-node {
        %object(json5-object-node),
        %array(json5-array-node),
        %string(json5-string-node),
        %number(json5-number-node),
        %boolean(json5-boolean-node),
        %null(json5-null-node),
    }
    parse-json5-value: func(text: string, offset: u32) -> result<json5-value-node, parse-error>;
    // AST Types
    variant json5-object-key-node {
        %identifier(json5-identifier-node),
        %string(json5-string-node),
    }
    parse-json5-object-key: func(text: string, offset: u32) -> result<json5-object-key-node, parse-error>;
    // AST Types
    variant json5-string-node {
        %string0(json5-string0-node),
        %string1(json5-string1-node),
    }
    parse-json5-string: func(text: string, offset: u32) -> result<json5-string-node, parse-error>;
    // AST Types
    variant json5-double-string-element-node {
        %hex-escape(json5-hex-escape-node),
        %any-escape(json5-any-escape-node),
        %double-string-text(json5-double-string-text-node),
    }
    parse-json5-double-string-element: func(text: string, offset: u32) -> result<json5-double-string-element-node, parse-error>;
    // AST Types
    variant json5-single-string-element-node {
        %hex-escape(json5-hex-escape-node),
        %any-escape(json5-any-escape-node),
        %single-string-text(json5-single-string-text-node),
    }
    parse-json5-single-string-element: func(text: string, offset: u32) -> result<json5-single-string-element-node, parse-error>;
    // AST Types
    variant json5-boolean-node {
        %true(json5-boolean0-node),
        %false(json5-boolean1-node),
    }
    parse-json5-boolean: func(text: string, offset: u32) -> result<json5-boolean-node, parse-error>;
    record json5-object-node {
        node: syntax-node
    }
    parse-json5-object: func(text: string, offset: u32) -> result<json5-object-node, parse-error>;
    record json5-object-pair-node {
        node: syntax-node
    }
    parse-json5-object-pair: func(text: string, offset: u32) -> result<json5-object-pair-node, parse-error>;
    record json5-array-node {
        node: syntax-node
    }
    parse-json5-array: func(text: string, offset: u32) -> result<json5-array-node, parse-error>;
    record json5-hex-escape-node {
        node: syntax-node
    }
    parse-json5-hex-escape: func(text: string, offset: u32) -> result<json5-hex-escape-node, parse-error>;
    record json5-any-escape-node {
        node: syntax-node
    }
    parse-json5-any-escape: func(text: string, offset: u32) -> result<json5-any-escape-node, parse-error>;
    record json5-double-string-text-node {
        node: syntax-node
    }
    parse-json5-double-string-text: func(text: string, offset: u32) -> result<json5-double-string-text-node, parse-error>;
    record json5-single-string-text-node {
        node: syntax-node
    }
    parse-json5-single-string-text: func(text: string, offset: u32) -> result<json5-single-string-text-node, parse-error>;
    record json5-number-node {
        node: syntax-node
    }
    parse-json5-number: func(text: string, offset: u32) -> result<json5-number-node, parse-error>;
    record json5-null-node {
        node: syntax-node
    }
    parse-json5-null: func(text: string, offset: u32) -> result<json5-null-node, parse-error>;
    record json5-identifier-node {
        node: syntax-node
    }
    parse-json5-identifier: func(text: string, offset: u32) -> result<json5-identifier-node, parse-error>;
    record json5-colon-node {
        node: syntax-node
    }
    parse-json5-colon: func(text: string, offset: u32) -> result<json5-colon-node, parse-error>;
    record json5-comma-node {
        node: syntax-node
    }
    parse-json5-comma: func(text: string, offset: u32) -> result<json5-comma-node, parse-error>;
    record json5-comment-node {
        node: syntax-node
    }
    parse-json5-comment: func(text: string, offset: u32) -> result<json5-comment-node, parse-error>;
    record json5-white-space-node {
        node: syntax-node
    }
    parse-json5-white-space: func(text: string, offset: u32) -> result<json5-white-space-node, parse-error>;
    record json5-string0-node {
        node: syntax-node
    }
    parse-json5-string0: func(text: string, offset: u32) -> result<json5-string0-node, parse-error>;
    record json5-string1-node {
        node: syntax-node
    }
    parse-json5-string1: func(text: string, offset: u32) -> result<json5-string1-node, parse-error>;
    record json5-boolean0-node {
        node: syntax-node
    }
    parse-json5-boolean0: func(text: string, offset: u32) -> result<json5-boolean0-node, parse-error>;
    record json5-boolean1-node {
        node: syntax-node
    }
    parse-json5-boolean1: func(text: string, offset: u32) -> result<json5-boolean1-node, parse-error>;
}

interface visitor {

}

interface listener {

}