grammar Json5 {
    patterns: ("*.json5")
}

/// https://spec.json5.org/#values
entry union Value {
    | Object  #Object
    | Array   #Array
    | String  #String
    | Number  #Number
    | Boolean #Boolean
    | Null    #Null
}

class Object {
    '{' (ObjectPair (COMMA ObjectPair)* COMMA)? '}'
}

class ObjectPair {
    ObjectKey COLON Value
}

union ObjectKey {
    | Identifier
    | String
}

class Array {
    '[' (Value (COMMA Value)* COMMA)? ']'
}

atomic union String {
    | '"' DoubleStringElement* '"'
    | "'" SingleStringElement* "'"
}

union DoubleStringElement {
    | HexEscape        #HexDigits
    | AnyEscape        #Escaped
    | DoubleStringText #StringText
}
union SingleStringElement {
    | HexEscape         #HexDigits
    | AnyEscape         #Escaped
    | SingleStringText  #StringText
}
class HexEscape {
    /\\u[0-9a-fA-F]{4}/
}
class AnyEscape {
    /\\./
}
class DoubleStringText {
    /[^"\\]+/
}
class SingleStringText {
    /[^'\\]+/
}

class Number {
    /[+-]?(0|[1-9][0-9]*)/
}

union Boolean {
    | "true"  #True
    | "false" #False
}

class Null {
    "null"
}

class Identifier {
    /[_\p{XID_start}][\p{XID_continue}]*/
}


token {
    COLON: ':'
    COMMA: ','
}

hide class Comment {
    | '#' ROL
}

hide class WhiteSpace {
    // UNICODE_WHITE_SPACE
    ' ' | '\n' | '\r'
}